# Application Configuration
APP_NAME="Desnky Global Resources"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=desnkygroup
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE=false

# Redis Configuration (Optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

# Mail Configuration (Future)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@desnkygroup.com
MAIL_FROM_NAME="Desnky Global Resources"

# Security
APP_KEY=
CSRF_PROTECTION=true

# Third-party Services
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_TOKEN=

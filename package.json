{
  "name": "desnkygroup-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend build tooling for the Desnky Global Resources Ltd website.",
  "scripts": {
    "dev": "tailwindcss -i ./resources/css/main.css -o ./public/assets/css/main.css --watch",
    "build": "tailwindcss -i ./resources/css/main.css -o ./public/assets/css/main.css && tailwindcss -i ./resources/css/main.css -o ./public/assets/css/main.min.css --minify",
    "audit": "npm audit --audit-level=moderate",
    "qa:assets": "npm run build && npm run audit"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
